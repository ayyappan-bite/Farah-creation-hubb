<!DOCTYPE html>
<html lang="en-IN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Farah Creation Hub</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{--blush:#F4C9D6;--pale:#F9E5EB;--cream:#FFF8EF;--ivory:#FFFCF7;--gold:#D4AF72;--rose:#A65D73;--brown:#6D5148;--card:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--cream:#2a2023;--ivory:#231a1d;--pale:#3a2a30;--card:#2f2327;--brown:#eadbd3}}
:root[data-theme="dark"]{--cream:#2a2023;--ivory:#231a1d;--pale:#3a2a30;--card:#2f2327;--brown:#eadbd3}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--ivory);color:var(--brown);font:16px/1.6 'DM Sans',system-ui,sans-serif}
h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:500;line-height:1.15;margin:0 0 .5em}
a{color:inherit;text-decoration:none}.wrap{max-width:1180px;margin:auto;padding:0 20px}
.bar{background:var(--rose);color:#fff;text-align:center;font-size:13px;padding:6px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--ivory);border-bottom:1px solid var(--blush)}
.nav{display:flex;align-items:center;gap:20px;height:68px}
.brand{display:flex;align-items:center;gap:10px;font-family:'Playfair Display',serif;font-size:19px}
.brand img{width:40px;height:40px;border-radius:50%;object-fit:cover}
nav{display:flex;gap:22px;margin-left:auto;font-size:14px}nav a:hover{color:var(--rose)}
.cart{background:var(--rose);color:#fff;border:0;border-radius:99px;padding:8px 16px;cursor:pointer;font:inherit}
.btn{display:inline-block;border-radius:99px;padding:13px 26px;font-weight:500;border:1px solid var(--rose);cursor:pointer;font:inherit}
.p{background:var(--rose);color:#fff}.s{color:var(--rose);background:transparent}
.hero{display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:center;padding:72px 0}
.hero h1{font-size:clamp(38px,6vw,68px)}.eyebrow{color:var(--gold);letter-spacing:.2em;font-size:12px;text-transform:uppercase}
.art{aspect-ratio:4/5;border-radius:200px 200px 24px 24px;background:radial-gradient(circle at 30% 20%,var(--pale),var(--blush));display:grid;place-items:center;border:1px solid var(--gold);position:relative}
.art img{width:62%;border-radius:50%;box-shadow:0 20px 50px #a65d7340}
.art small{position:absolute;bottom:14px;font-size:11px;opacity:.7}
section{padding:64px 0}.alt{background:var(--cream)}
.grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
.cat{background:var(--pale);border:1px solid var(--blush);border-radius:18px;padding:26px 18px;text-align:center;font-family:'Playfair Display',serif;transition:.25s}
.cat:hover{transform:translateY(-3px);border-color:var(--gold)}
.card{background:var(--card);border:1px solid var(--blush);border-radius:18px;overflow:hidden}
.ph{aspect-ratio:1;background:linear-gradient(135deg,var(--pale),var(--blush));display:grid;place-items:center;font-size:12px;opacity:.9}
.card div.b{padding:14px}.price{color:var(--rose);font-weight:500}
.steps{counter-reset:s}.step{padding:20px;border-top:2px solid var(--gold)}.step:before{counter-increment:s;content:"0" counter(s);color:var(--gold);font-family:'Playfair Display',serif;font-size:28px;display:block}
.center{text-align:center}.note{background:var(--pale);border:1px dashed var(--gold);border-radius:14px;padding:14px 18px;font-size:14px}
footer{background:var(--brown);color:#fff8ef;padding:48px 0;font-size:14px}
dialog{border:1px solid var(--gold);border-radius:18px;max-width:420px;width:92%;background:var(--ivory);color:var(--brown)}
.row{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--blush)}
.opt{display:flex;flex-wrap:wrap;gap:8px}.opt button{border:1px solid var(--blush);background:var(--card);color:inherit;border-radius:99px;padding:8px 16px;cursor:pointer;font:inherit}.opt button.on{background:var(--rose);color:#fff;border-color:var(--rose)}
@media(max-width:820px){nav{display:none}.hero{grid-template-columns:1fr;padding:36px 0}.art{order:-1;max-width:340px;margin:auto}.cart{margin-left:auto}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style></head><body>
<div class="bar">Beautiful Gifts, Thoughtfully Made ♡</div>
<header><div class="wrap nav">
<a class="brand" href="#top"><img src="data:image/jpeg;base64," alt="Farah Creation Hub logo">Farah Creation Hub</a>
<nav><a href="#shop">Shop</a><a href="#builder">Create Your Own Hamper</a><a href="#story">Our Story</a><a href="#gallery">Gallery</a><a href="#contact">Contact</a></nav>
<button class="cart" id="cb">Cart (<span id="cn">0</span>)</button></div></header>

<main id="top"><div class="wrap hero">
<div><div class="eyebrow">We Create Hampers As Per Your Wish, With Love.</div>
<h1>Every Gift Begins With Love.</h1>
<p>Beautifully curated hampers, thoughtfully personalised to celebrate your most special moments.</p>
<p><a class="btn p" href="#shop">Explore Our Hampers</a> &nbsp; <a class="btn s" href="#builder">Create Your Own Hamper</a></p></div>
<div class="art"><img src="data:image/jpeg;base64," alt=""><small>Photography placeholder — replace with your hamper photo</small></div></div>

<section class="alt" id="story"><div class="wrap center"><h2>Little Details. Endless Love.</h2>
<p style="max-width:680px;margin:auto">At Farah Creation Hub, we believe every gift tells a story. From thoughtfully selected treats to personalised keepsakes and elegant packaging, we create beautiful hampers that reflect your wishes and make every occasion more meaningful.</p></div></section>

<section id="cats"><div class="wrap"><h2 class="center">Shop by Occasion</h2><div class="grid" id="catg"></div></div></section>

<section class="alt" id="shop"><div class="wrap"><h2>Ready-Made Hampers</h2>
<p class="note">Sample catalogue for layout only. Names and prices are placeholders until you add real products in the admin.</p><br>
<div class="grid" id="prod"></div></div></section>

<section id="builder"><div class="wrap center"><h2>Create Your Own Hamper</h2>
<p>Your Wish. Your Style. Your Hamper. Our Love.</p>
<div style="max-width:620px;margin:24px auto;text-align:left">
<h3>1 · Occasion</h3><div class="opt" data-k="occ"></div>
<h3 style="margin-top:20px">2 · Budget</h3><div class="opt" data-k="bud"></div>
<h3 style="margin-top:20px">3 · Box</h3><div class="opt" data-k="box"></div>
<p id="sum" class="note" style="margin-top:20px">Choose an option in each step.</p>
<p><button class="btn p" id="req">Request a Custom Quote</button></p></div></div></section>

<section class="alt"><div class="wrap"><h2 class="center">Why Choose Us</h2><div class="grid" id="why"></div></div></section>
<section><div class="wrap"><h2 class="center">How It Works</h2><div class="grid steps">
<div class="step">Choose Your Hamper.</div><div class="step">Personalise Your Gift.</div><div class="step">Place Your Order.</div><div class="step">We Create It With Love.</div></div></div></section>
<section class="alt" id="gallery"><div class="wrap center"><h2>A Little Peek Into Our World ♡</h2>
<p><a class="btn s" href="https://instagram.com/farah_creation_hub" target="_blank" rel="noopener">Visit our Instagram</a></p></div></section>
</main>
<footer id="contact"><div class="wrap"><h3>Farah Creation Hub</h3>
<p>Call or WhatsApp: <a href="tel:+916381238529">+91 6381238529</a><br>Instagram: <a href="https://instagram.com/farah_creation_hub" target="_blank" rel="noopener">@farah_creation_hub</a></p>
<p>© Farah Creation Hub</p></div></footer>

<dialog id="d"><h3>Your Cart</h3><div id="cl"></div><p class="row"><b>Total</b><b id="ct">₹0</b></p>
<p class="note">Online payment is not connected in this prototype.</p><p><button class="btn s" onclick="d.close()">Close</button></p></dialog>
<script>
const $=s=>document.querySelector(s),inr=p=>'₹'+(p/100).toLocaleString('en-IN');
const cats=['Birthday','Anniversary','Romantic','Wedding','Bridesmaid','Baby Shower','Chocolate','Beauty & Skincare','Perfumes','Jewellery','Flowers & Soft Toys','Self-Care','Personalised','Corporate','Festival'];
$('#catg').innerHTML=cats.map(c=>`<a class="cat" href="#shop">${c} Hampers</a>`).join('');
const prods=[['Sample Birthday Hamper',129900],['Sample Romantic Hamper',189900],['Sample Chocolate Box',79900],['Sample Self-Care Hamper',149900]];
$('#prod').innerHTML=prods.map((p,i)=>`<div class="card"><div class="ph">Product image</div><div class="b"><h3>${p[0]}</h3><div class="price">${inr(p[1])}</div><p><button class="btn p" style="padding:8px 18px" onclick="add(${i})">Add to Cart</button></p></div></div>`).join('');
$('#why').innerHTML=['Made Just for You','Thoughtfully Curated','Beautifully Packaged','Gifts for Every Occasion','Personalised With Love','Your Vision, Our Creativity'].map(t=>`<div class="card"><div class="b"><h3>${t}</h3></div></div>`).join('');
let cart=[];try{cart=JSON.parse(localStorage.getItem('fch')||'[]')}catch(e){}
function save(){try{localStorage.setItem('fch',JSON.stringify(cart))}catch(e){}$('#cn').textContent=cart.length;$('#cl').innerHTML=cart.map((p,i)=>`<div class="row"><span>${p[0]}</span><span>${inr(p[1])} <a href="#" onclick="cart.splice(${i},1);save();return false">✕</a></span></div>`).join('')||'<p>Your cart is empty.</p>';$('#ct').textContent=inr(cart.reduce((a,p)=>a+p[1],0))}
function add(i){cart.push(prods[i]);save()}
$('#cb').onclick=()=>d.showModal();save();
const sel={},O={occ:['Birthday','Anniversary','Wedding','Valentine\'s Day','Baby Shower','Corporate','Other'],bud:['Under ₹500','₹500–₹1,000','₹1,000–₹2,000','₹2,000–₹3,000','₹3,000 and above'],box:['Small Gift Box','Medium Gift Box','Large Gift Box','Premium Rigid Box','Gift Basket']};
document.querySelectorAll('.opt').forEach(el=>{const k=el.dataset.k;el.innerHTML=O[k].map(o=>`<button>${o}</button>`).join('');el.onclick=e=>{if(e.target.tagName!='BUTTON')return;el.querySelectorAll('button').forEach(b=>b.classList.remove('on'));e.target.classList.add('on');sel[k]=e.target.textContent;$('#sum').textContent=`${sel.occ||'—'} · ${sel.bud||'—'} · ${sel.box||'—'}`}});
$('#req').onclick=()=>{const m=`Hi Farah Creation Hub, I'd like a custom hamper quote. Occasion: ${sel.occ||'-'}, Budget: ${sel.bud||'-'}, Box: ${sel.box||'-'}.`;window.open('https://wa.me/916381238529?text='+encodeURIComponent(m),'_blank')}
</script></body></html>
